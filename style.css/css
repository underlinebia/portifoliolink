* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'DM Sans', sans-serif;
    background-color: #FCF8F8;
    color: #55555;
    line-height: 1.6;
}

.container {
    display: flex;
    max-width: 1000px;
    margin: 0 auto;
    min-height: 100vh;
}

.sidebar {
    width: 260px;
    padding: 60px 30px;
    border-right: 1px dotted #e6caca;
    position: sticky;
    top: 0;
    height: 100vh;
}

.avatar-box {
    display: flex;
    justify-content: center;
    margin-bottom: 40px;
}

.avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #F9E0E0;
}

.menu {
    display: flex;
    flex-direction: column;
}

.menu-item {
    text-decoration: none;
    color: #666666;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 1px;
    padding: 14px 5px;
    border-bottom: 1px dotted #ead6d6;
    transition: color 0.2s, padding-left 0.2s;
    cursor: pointer;
}

.menu-item:first-child {
    border-top: 1px dotted #ead6d6;
}

.menu-item:hover, .menu-item.ativo-menu {
    color: #F3A6A6;
    padding-left: 10px;
}

.content {
    flex: 1;
    padding: 60px 60px;
}

.tab-section {
    display: none;
}

.tab-section.ativa {
    display: block;
    animation: fadeInTab 0.3s ease-in-out;
}

@keyframes fadeInTab {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
}

.post-block {
    margin-bottom: 40px;
}

.post-title {
    color: #F3A6A6;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
}

.post-subtitle {
    color: #d48383;
    font-size: 0.9rem;
    font-weight: 700;
    margin-top: 16px;
    margin-bottom: 6px;
}

.post-text {
    font-size: 0.92rem;
    color: #666666;
    margin-bottom: 12px;
}

.post-list {
    margin-left: 20px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    color: #666666;
}

.post-list li {
    margin-bottom: 6px;
}

.post-footer {
    display: flex;
    justify-content: space-between;
    padding-top: 14px;
    margin-top: 24px;
    border-top: 1px dotted #ead6d6;
    font-size: 0.72rem;
    color: #b59a9a;
    letter-spacing: 1px;
}

@media (max-width: 768px) {
    .container { flex-direction: column; }
    .sidebar { width: 100%; height: auto; position: static; border-right: none; border-bottom: 1px dotted #e6caca; padding: 30px 20px; }
    .content { padding: 40px 25px; }
}
.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
}

.project-item {
    background-color: #ffffff;
    border: 1px solid #f0e1e1;
    border-radius: 4px;
    overflow: hidden;
    transition: background-color 0.3s ease;
}

.project-header {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: background-color 0.3s ease;
}

.project-date {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: #F3A6A6;
    transition: color 0.3s ease;
}

.project-sub {
    font-size: 0.68rem;
    color: #aaaaaa;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
}

.project-item:hover .project-header {
    background-color: #F9E0E0;
}

.project-item:hover .project-date,
.project-item:hover .project-sub {
    color: #ffffff;
}

.project-thumb {
    position: relative;
    width: 100%;
    height: 280px;
    cursor: pointer;
    overflow: hidden;
}

.project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.project-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 138, 138, 0.45);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.project-thumb:hover .project-overlay {
    opacity: 1;
}

.overlay-icon {
    font-size: 1.8rem;
    color: #ffffff;
    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.3));
}

.lightbox {
    display: none;
    position: fixed;
    z-index: 9999;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
    padding: 30px;
    cursor: zoom-out;
}

.lightbox.aberto {
    display: flex;
    animation: fadeInTab 0.25s ease;
}

.lightbox img {
    max-width: 90%;
    max-height: 90vh;
    border-radius: 4px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.4);
}

.lightbox-close {
    position: absolute;
    top: 25px;
    right: 35px;
    color: #ffffff;
    font-size: 1.8rem;
    font-weight: bold;
    cursor: pointer;
}
.contact-form {
    margin-top: 20px;
    background: #ffffff;
    border: 1px solid #f0e1e1;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(243, 166, 166, 0.08);
}

.contact-textarea {
    width: 100%;
    height: 150px;
    border: none;
    padding: 18px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.92rem;
    color: #555555;
    resize: none;
    outline: none;
    background: transparent;
}

.contact-textarea::placeholder {
    color: #b59a9a;
}

.contact-footer-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    background-color: #fcf4f4;
    border-top: 1px solid #f0e1e1;
}

.contact-email-hint {
    font-size: 0.78rem;
    color: #b59a9a;
    font-weight: 500;
}

.contact-btn {
    background-color: #F3A6A6; 
    color: #ffffff;
    border: none;
    padding: 7px 22px;
    border-radius: 4px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

.contact-btn:hover {
    background-color: #e08b8b;
}

.contact-btn:active {
    transform: scale(0.98);
}
.contact-links {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    font-size: 0.88rem;
}

.social-link {
    color: #F3A6A6 !important; 
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s, padding-left 0.2s;
}

.social-link:hover {
    color: #e08b8b !important;
    text-decoration: underline;
}

.link-separator {
    color: #d4b5b5;
    font-size: 0.8rem;
